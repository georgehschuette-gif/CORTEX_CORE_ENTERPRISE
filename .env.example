# Cortex Core Environment Configuration
# Copy this file to .env and update values as needed

# System Configuration
CORTEX_ENVIRONMENT=development
CORTEX_LOG_LEVEL=INFO
CORTEX_MODE=adaptive

# API Configuration
CORTEX_API_HOST=0.0.0.0
CORTEX_API_PORT=8080
CORTEX_API_WORKERS=4

# Security Configuration
CORTEX_SECURITY_KEY=your-super-secret-key-here-change-this-in-production
CORTEX_ENCRYPTION_ENABLED=true
CORTEX_AUTH_ENABLED=false
CORTEX_JWT_SECRET=your-jwt-secret-here

# Database Configuration
CORTEX_DATABASE_URL=sqlite:///data/cortex.db
CORTEX_REDIS_URL=redis://localhost:6379

# Monitoring Configuration
CORTEX_METRICS_PORT=8081
CORTEX_HEALTH_CHECK_INTERVAL=30

# Distributed Configuration
CORTEX_CLUSTER_ENABLED=false
CORTEX_NODE_ID=node-1
CORTEX_PEERS=node-2,node-3

# External Services
OPENAI_API_KEY=your-openai-key-here
PINECONE_API_KEY=your-pinecone-key-here
QDRANT_URL=http://localhost:6333

# AWS Configuration (for enterprise deployment)
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=us-east-1

# Azure Configuration (for enterprise deployment)
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=your-azure-tenant-id

# Google Cloud Configuration (for enterprise deployment)
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
